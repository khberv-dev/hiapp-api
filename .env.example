PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=hiapp

JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated OAuth client IDs (Android, iOS, web) that Google ID tokens must be issued to (`aud`)
GOOGLE_CLIENT_IDS=

# AI backend: "gemini" (Gemini Developer API, needs GEMINI_API_KEY) or "vertex" (Vertex AI)
GENAI_BACKEND=gemini
GEMINI_API_KEY=
# Vertex only: service account JSON key, relative to the project root (gitignored)
GOOGLE_CREDENTIALS_FILE=google-service-account.json
# Vertex only: defaults to the key's project_id
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Conversation time per day, in seconds, for users WITHOUT an active subscription (1800 = 30 min).
# Subscribed users get their plan's daily_limit_seconds instead.
DAILY_LIMIT_SECONDS=1800
# IANA timezone whose midnight resets the daily limit (default UTC)
USAGE_TIMEZONE=Asia/Tashkent

# Optional overrides (defaults shown)
STT_MODEL=gemini-3.5-transcribe-live
# Comma-separated BCP-47 codes for transcription (empty = auto-detect)
STT_LANGUAGES=en-US
# Server-side silence (ms) before an utterance is finalized; below ~500 cuts learners off
STT_SILENCE_MS=500
# Give up (close 1011) after STT has been unreachable this long
STT_RECONNECT_BUDGET_MS=20000
# Audio since the last final transcript replayed after an STT reconnect
STT_REPLAY_BUFFER_MS=5000
# Comma-separated fallback chain, tried in order until one produces a token
LLM_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# A model with no first token within this time is skipped for the next one
LLM_FIRST_TOKEN_MS=2500
# Comma-separated TTS fallback chain (all must output the same sample rate)
TTS_MODELS=gemini-3.8-flash-tts
TTS_VOICE=Kore
# Extra attempts per TTS model and sentence, and the per-attempt first-chunk deadline
TTS_RETRIES=2
TTS_FIRST_CHUNK_MS=2500

# POST /auth/login rate limit (per process): attempts per email (reset on success)
# and per client IP, within a fixed window
AUTH_LOGIN_MAX_PER_EMAIL=5
AUTH_LOGIN_MAX_PER_IP=20
AUTH_LOGIN_WINDOW_SEC=900
# Set behind a reverse proxy so req.ip is the client, not the proxy:
# true, a hop count (e.g. 1), or an Express trust value (e.g. loopback). Empty = off
TRUST_PROXY=

# WebSocket ping interval; a client that misses one pong is terminated
WS_PING_MS=15000
# A dropped conversation can be resumed with ?resume=<id> within this many seconds
RESUME_WINDOW_SEC=120
# Also send per-turn timings to the client as `turn_metrics`
SEND_TURN_METRICS=false
# TESTING ONLY: probability (0-1) of injected 503s / STT drops on every AI call
AI_FAULT_RATE=0

# Multicard (RHMT) payments: https://docs.multicard.uz
# Sandbox: https://dev-mesh.multicard.uz  Production: https://mesh.multicard.uz
RHMT_API_URL=https://dev-mesh.multicard.uz
RHMT_APPLICATION_ID=rhmt_test
RHMT_SECRET=change-me
RHMT_STORE_ID=6
# Public URL of POST /payment/handle on this API
RHMT_CALLBACK_URL=https://example.com/payment/handle
