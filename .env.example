PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=hiapp

JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated OAuth client IDs (Android, iOS, web) that Google ID tokens must be issued to (`aud`)
GOOGLE_CLIENT_IDS=

GEMINI_API_KEY=

# Conversation time each user gets per day, in seconds (1800 = 30 min)
DAILY_LIMIT_SECONDS=1800
# IANA timezone whose midnight resets the daily limit (default UTC)
USAGE_TIMEZONE=Asia/Tashkent

# Optional overrides (defaults shown)
STT_MODEL=gemini-3.5-transcribe-live
# Comma-separated fallback chain, tried in order until one produces a token
LLM_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
